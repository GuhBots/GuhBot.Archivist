# Files kept out of image builds, whose context is the repository root.
# Secrets must never reach an image.
.env
.env.*
!.env.example

# Version control and development files that the service does not need.
.git
.devcontainer

# Build outputs, dependencies, and local data. The build stage installs
# and compiles its own.
node_modules
**/node_modules
**/build
**/dist
**/.test-build
**/.test-build-*
data
*.local.md
