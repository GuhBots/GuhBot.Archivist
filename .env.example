# Copy this file to .env on each machine and fill in real values.
# Never commit .env. Share secrets through a password manager.
# Each setting here must also be listed under environment in compose.yaml.
# docs/guides/self-hosting.md explains each one.

# Image tag to run:
#   1.2.3   A specific release. Use this to pin or roll back.
#   latest  The newest release.
#   main    The newest merge to main, for testing.
APP_VERSION=latest

# The address people type to reach the website, including any path, such as
# https://guhbot.example.com/archivist. Plain http works only for localhost.
ARCHIVIST_BASE_URL=http://localhost:3000

# Discord user IDs of the owners, separated by commas. Owners create
# archives, manage whitelists, and export. The service refuses to start
# without at least one. Owners still sign in with Discord.
ARCHIVIST_OWNER_IDS=

# Discord sign-in, from the Discord application's OAuth2 page in the
# Developer Portal. Add <ARCHIVIST_BASE_URL>/auth/discord/callback under
# Redirects, exactly, such as http://localhost:3000/auth/discord/callback.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Signs website session cookies. Generate one with: openssl rand -hex 32
# Changing it signs everyone out.
ARCHIVIST_SESSION_SECRET=

# The Discord bot's credential for the API. Generate one with:
#   openssl rand -hex 32
# Put the same value in the bot's .env as ARCHIVIST_SERVICE_TOKEN. It is not
# the bot's Discord token. Leave it empty to refuse the bot; the website
# keeps working. docs/guides/connecting-the-bot.md explains how to change it.
ARCHIVIST_SERVICE_TOKEN=

# Optional Google API key for contributors' public Google Drive links.
# Without it, public files download the way a browser's download button
# does. With it, the official Drive API is used. Restrict it to that API.
GOOGLE_DRIVE_API_KEY=

# Optional Discord bot token, so the website can fetch an account's current
# avatar from its Discord ID. Discord shows other people's profiles only to
# bots. Any application's bot works, with no servers and no permissions.
# Use one other than the GuhBot bot, so the bot's own token stays with the
# bot. Without it, avatars are uploaded by hand.
DISCORD_BOT_TOKEN=

# Where the host publishes the website's port, as ADDRESS:PORT. The default
# reaches it only from this machine, which is enough for the Cloudflare
# Tunnel below and a reverse proxy on this machine.
ARCHIVIST_PUBLISH=127.0.0.1:3000

# Optional Cloudflare Tunnel token, from the tunnel's page in Cloudflare's
# dashboard. Used only with: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Running without Docker, such as npm start in a clone, also reads these.
# The image sets them itself.
# DATA_DIR=data
# ARCHIVIST_HOST=127.0.0.1
# ARCHIVIST_PORT=3000
